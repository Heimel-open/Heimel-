  "tests": [
    {
      "id": "HCONF-001",
      "name": "fresh-valid-authority-allows-bound-effect",
      "required": true,
      "input": {
        "authority": {
          "present": true,
          "revoked": false,
          "expires_at": "2026-10-02T13:00:00Z",
          "checked_at": "2026-10-02T12:30:00Z",
          "scope": [
            "lamp:on"
          ],
          "version": "A2"
        },
        "effect": {
          "id": "lamp-1",
          "action": "on",
          "authority_version": "A2"
        },
        "required_info_complete": true
      },
      "expect": {
        "decision": "ALLOW",
        "effect_may_execute": true,
        "evidence_required": true
      }
    },
    {
